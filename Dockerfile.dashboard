FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.11.9 /uv /uvx /bin/
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --locked --no-dev --extra dashboard

USER 10002:10002
EXPOSE 8501
CMD ["/app/.venv/bin/streamlit", "run", "src/survivallab/dashboard_app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
