FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.11.9 /uv /uvx /bin/
COPY pyproject.toml uv.lock ./
COPY src ./src
COPY migrations ./migrations
COPY dbt/pyproject.toml dbt/uv.lock ./dbt/
COPY dbt/dbt_project.yml dbt/profiles.yml ./dbt/
COPY dbt/macros ./dbt/macros
COPY dbt/models ./dbt/models
COPY dbt/tests ./dbt/tests
COPY alembic.ini ./
RUN uv sync --locked --no-dev --extra db --extra api
RUN uv sync --project dbt --locked

USER 10001:10001
EXPOSE 8000
CMD ["/app/.venv/bin/uvicorn", "survivallab.api:app", "--host", "0.0.0.0", "--port", "8000"]
